# TEMPLATE ONLY: copy to .env.railway.web.local (ignored by Git).
# Replace REPLACE_ME values before publishing. Never commit the .local file.
APP_NAME=vukem-trading
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_ME_GENERATED_APP_KEY_SHARED_WITH_ENGINE
APP_PREVIOUS_KEYS=
HOST=0.0.0.0
# Railway provides PORT; do not copy the local engine health port.
APP_URL=https://replace-me.up.railway.app
# Change Postgres to the exact PostgreSQL service name when using Railway refs.
DATABASE_URL=${{Postgres.DATABASE_URL}}
SESSION_DRIVER=database
CACHE_STORE=database
MAIL_MAILER=log
OWNER_GOOGLE_EMAIL=owner@example.invalid
SOCIAL_GOOGLE_CLIENT_ID=REPLACE_ME_GOOGLE_CLIENT_ID
SOCIAL_GOOGLE_CLIENT_SECRET=REPLACE_ME_GOOGLE_CLIENT_SECRET
# Callback: https://YOUR-WEB-DOMAIN/auth/google/callback
# Keep blank until genuine paper credentials are available; used for IEX import.
# Placeholders: REPLACE_ME_ALPACA_PAPER_KEY / REPLACE_ME_ALPACA_PAPER_SECRET
ALPACA_API_KEY=
ALPACA_API_SECRET=
