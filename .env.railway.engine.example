# TEMPLATE ONLY: copy to .env.railway.engine.local (ignored by Git).
APP_NAME=vukem-trading
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_ME_GENERATED_APP_KEY_SHARED_WITH_WEB
APP_PREVIOUS_KEYS=
HOST=0.0.0.0
APP_URL=https://app.trading.vukem.dev
DATABASE_URL=${{Postgres.DATABASE_URL}}
SESSION_DRIVER=database
CACHE_STORE=database
MAIL_MAILER=log
# Blank means use Railway's PORT. Locally this would be 3001.
ENGINE_HEALTH_PORT=
# Empty placeholders intentionally disable external calls until configured.
# ALPACA_API_KEY placeholder: REPLACE_ME_ALPACA_PAPER_KEY
# ALPACA_API_SECRET placeholder: REPLACE_ME_ALPACA_PAPER_SECRET
ALPACA_API_KEY=
ALPACA_API_SECRET=
# TELEGRAM_BOT_TOKEN placeholder: REPLACE_ME_TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID placeholder: REPLACE_ME_TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
